<%- include("../../../views/partials/header") %>

<main class="content">
  <h1>Faculty Directory</h1>
  <p>Faculty profiles can be sorted by name, department, or title.</p>

  <div class="sort-options" aria-label="Sort faculty members">
    <span>Sort:</span>
    <a href="/faculty" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
    <a href="/faculty?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>
    <a href="/faculty?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
  </div>

  <div class="faculty-list">
    <% facultyMembers.forEach((facultyMember) => { %>
      <article class="faculty-card">
        <h2><a href="/faculty/<%= facultyMember.id %>"><%= facultyMember.name %></a></h2>
        <p><%= facultyMember.title %></p>
        <p><%= facultyMember.department %></p>
      </article>
    <% }); %>
  </div>
</main>

<%- include("../../../views/partials/footer") %>
