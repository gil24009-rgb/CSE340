<%- include("partials/header") %>

<main class="content">
  <h1><%= title %></h1>

  <section class="demo-section">
    <h2>Shared Values</h2>
    <p><strong>Session:</strong> <%= greeting %></p>
    <p><strong>Year:</strong> <%= currentYear %></p>
    <p><strong>Theme:</strong> muted blue</p>

    <% if (Object.keys(queryParams).length > 0) { %>
      <p><strong>Query string:</strong></p>
      <ul>
        <% Object.keys(queryParams).forEach((key) => { %>
          <li><strong><%= key %>:</strong> <%= queryParams[key] %></li>
        <% }); %>
      </ul>
    <% } else { %>
      <p>No query string values were sent.</p>
    <% } %>
  </section>

  <section class="demo-section">
    <h2>Route Headers</h2>
    <p>Custom headers are added on this route: <code>X-Demo-Page</code> and <code>X-Middleware-Demo</code>.</p>
  </section>
</main>

<%- include("partials/footer") %>
