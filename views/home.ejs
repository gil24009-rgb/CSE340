<%- include("partials/header") %>

<main class="content">
  <section class="hero-panel">
    <div class="hero-copy">
      <p class="eyebrow">Spring 2026</p>
      <h1><%= title %></h1>
      <p>
        <span>Start with the available course data,</span>
        <span>then choose the task that matches what you need next.</span>
      </p>
    </div>
    <aside class="hero-status" aria-label="Course hub summary">
      <div class="status-card status-card-primary">
        <span>Live tools</span>
        <strong>3</strong>
      </div>
      <div class="status-card">
        <span>Courses</span>
        <strong><%= courseCount %></strong>
      </div>
      <div class="status-card">
        <span>Sections</span>
        <strong><%= sectionCount %></strong>
      </div>
      <div class="status-card">
        <span>Faculty</span>
        <strong><%= facultyCount %></strong>
      </div>
    </aside>
  </section>

  <section class="summary-grid" aria-label="Project areas">
    <a class="summary-card" href="/catalog">
      <span class="card-index">01</span>
      <strong>Plan a section</strong>
      <small>
        <span>Compare section times, rooms,</span>
        <span>and instructors.</span>
      </small>
    </a>
    <a class="summary-card" href="/faculty">
      <span class="card-index">02</span>
      <strong>Find an instructor</strong>
      <small>
        <span>Browse instructors by name, title,</span>
        <span>or department.</span>
      </small>
    </a>
    <a class="summary-card" href="/demo">
      <span class="card-index">03</span>
      <strong>Check page context</strong>
      <small>
        <span>Review the current page values</span>
        <span>used by the app.</span>
      </small>
    </a>
  </section>
</main>

<%- include("partials/footer") %>
