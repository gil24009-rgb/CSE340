<%- include("partials/header") %>

<main class="content">
  <section class="hero-panel">
    <p class="eyebrow">Course tools</p>
    <h1><%= title %></h1>
    <p>
      Find course sections, review faculty profiles, and check request details from one place.
    </p>
  </section>

  <section class="summary-grid" aria-label="Project areas">
    <a class="summary-card" href="/catalog">
      <span>Catalog</span>
      <strong>Course sections</strong>
      <small>Compare times, rooms, and instructors.</small>
    </a>
    <a class="summary-card" href="/faculty">
      <span>Faculty</span>
      <strong>Directory</strong>
      <small>Browse instructors by name, title, or department.</small>
    </a>
    <a class="summary-card" href="/demo">
      <span>Request</span>
      <strong>Page context</strong>
      <small>Review the current page values used by the app.</small>
    </a>
  </section>
</main>

<%- include("partials/footer") %>
